@page "/agents"
@implements IDisposable
@inject AgentRunService Runner
@inject IDbContextFactory<EvalDb> Dbs
@inject EvalService Eval

<PageTitle>Agent runner · OBC Evaluation</PageTitle>
<h1>Agent runner</h1>

<div class="panel">
    <p>Agent models run from this page. The app starts a <b>fresh CLI process</b> for each run in an empty folder with only that setup's data source, then saves the reply, timing, and usage reported by the CLI.</p>
    <p class="small muted">CLI choice and setup-specific launch settings come from each model profile. Sign in to the selected CLI once using its normal sign-in flow.</p>
</div>

<div class="panel">
    @if (agents.Count == 0)
    {
        <p class="muted">No model is in agent mode. Set a model's mode to agent on the <a href="models">Models</a> page.</p>
    }
    else
    {
        <div class="row">
            <label>Model
                <select @bind="modelId" disabled="@busy">
                    @foreach (var m in agents) { <option value="@m.Id">@m.Name · @m.ModelVersion · @m.AgentCli</option> }
                </select>
            </label>
            <label>Size
                <select @bind="size" disabled="@busy">
                    <option value="0">Any</option>
                    @foreach (var s in Eval.Bundle.Datasets.Select(d => d.Size)) { <option value="@s">@s.ToString("N0")</option> }
                </select>
            </label>
            <label>Setup
                <select @bind="setup" disabled="@busy">
                    <option value="">Any</option>
                    @foreach (var s in Eval.Bundle.Setups) { <option value="@s">@Wizard.SetupName(s)</option> }
                </select>
            </label>
            <label>Max runs (0 = all)
                <input type="number" min="0" style="width:7rem" @bind="maxRuns" disabled="@busy" />
            </label>
            <label>Cost cap, USD (optional)
                <input type="number" min="0" step="0.5" style="width:8rem" @bind="maxCost" disabled="@(busy || SelectedCli == "codex")" />
            </label>
        </div>
        @if (SelectedCli == "codex") { <p class="small muted">Codex CLI does not report per-run USD cost, so the cost cap is unavailable for this model.</p> }
        <div class="row" style="margin-top:0.75rem">
            <button class="primary" @onclick="StartAsync" disabled="@(busy || modelId == 0)">Start</button>
            <button @onclick="Runner.Pause" disabled="@(status.State != AgentServiceState.Running)">Pause after this run</button>
            <button class="danger" @onclick="Runner.Stop" disabled="@(!busy)">Stop now</button>
            <button @onclick="PreflightAsync" disabled="@(busy || checking || modelId == 0)">@(checking ? "Checking…" : "Check setup")</button>
        </div>
        @if (error != null) { <p class="badge bad" style="margin-top:0.5rem">@error</p> }
    }
</div>

@if (preflight != null)
{
    <h2>Setup check</h2>
    <div class="panel">
        <table>
            <thead><tr><th>Setup</th><th>Result</th><th>Details</th><th>Seen by the agent</th></tr></thead>
            <tbody>
                @foreach (var r in preflight)
                {
                    <tr>
                        <td>@Wizard.SetupName(r.Setup)</td>
                        <td><span class="badge @(r.Ok ? "ok" : "bad")">@(r.Ok ? "ok" : "problem")</span> <span class="small muted">@r.Seconds.ToString("0")s</span></td>
                        <td class="small">@r.Message</td>
                        <td class="small">
                            @if (r.Context is { } c)
                            {
                                <div>model: <code>@(c.Model ?? "not reported")</code></div>
                                @if (c.McpServers.Count > 0) { <div>MCP servers: @string.Join(", ", c.McpServers)</div> }
                                @if (c.DataToolCalls is { } calls) { <div>Data tool calls: @calls</div> }
                                <div>skills: @(c.Skills.Count > 0 ? string.Join(", ", c.Skills) : "none")</div>
                            }
                            else { <span class="muted">not reported by this tool</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="small muted">The check sends a short prompt through each setup. It proves the CLI starts and is signed in; it can't prove the connector returns the right data.</p>
    </div>
}

<h2>Session</h2>
<div class="panel">
    <div class="row">
        <span class="badge @(status.State == AgentServiceState.Idle ? "" : "warn")">@status.State</span>
        @if (status.Current != null) { <b>@status.Current</b> @if (Runner.Progress != null) { <span class="muted"> · @Runner.Progress</span> } }
        <span class="muted small">@status.Done saved · @status.Failed failed@(status.CostUsd > 0 ? $" · ${status.CostUsd:0.####}" : "")@(status.StartedAt is { } t ? $" · started {t:t}" : "")</span>
        <a class="small" href="runs">Runs</a>
    </div>
    @if (logLines.Count == 0) { <p class="muted small">Nothing yet.</p> }
    else { <pre style="max-height:20rem">@string.Join("\n", logLines)</pre> }
    <p class="small muted">After @AgentRunService.MaxFailuresInARow failed runs in a row the session stops, and a run that fails to start is abandoned with its reason and offered again. An attempt with no result after @EvalService.StaleAgentAttempt.TotalHours hours is abandoned the same way.</p>
</div>

@code {
    private List<ModelProfile> agents = new();
    private AgentStatus status = null!;
    private List<string> logLines = new();
    private List<PreflightResult>? preflight;
    private int modelId, size, maxRuns;
    private string? setup;
    private decimal? maxCost;
    private bool checking;
    private string? error;
    private bool busy => status.State != AgentServiceState.Idle;
    private string SelectedCli => agents.FirstOrDefault(m => m.Id == modelId)?.AgentCli ?? "";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        agents = await db.Models.AsNoTracking().Where(m => m.Mode == Modes.Agent && m.Active).OrderBy(m => m.Name).ToListAsync();
        modelId = agents.FirstOrDefault()?.Id ?? 0;
        Refresh();
        Runner.Changed += OnChanged;
    }

    private void Refresh()
    {
        status = Runner.Status;
        logLines = Runner.Log.ToList();
    }

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private async Task StartAsync()
    {
        error = await Runner.StartAsync(new AgentRunRequest(modelId, size == 0 ? null : size, string.IsNullOrEmpty(setup) ? null : setup, maxRuns, maxCost is > 0 ? maxCost : null));
        Refresh();
    }

    private async Task PreflightAsync()
    {
        checking = true;
        preflight = null;
        StateHasChanged();
        try { preflight = await Runner.PreflightAsync(modelId); }
        finally { checking = false; }
    }

    public void Dispose() => Runner.Changed -= OnChanged;
}
